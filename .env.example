# Public URL of the site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://billzoa.com

# Where contact-form submissions are POSTed as JSON (Slack/Zapier/Make/n8n/your own endpoint).
# Required in production, otherwise /api/contact returns a 503 and the form shows the email fallback.
CONTACT_WEBHOOK_URL=
